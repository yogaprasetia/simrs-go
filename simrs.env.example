# Salin menjadi simrs.env lalu sesuaikan. Jangan commit simrs.env.
DB_USER=simrs
DB_PASS=
DB_HOST=127.0.0.1:3306
DB_NAME=sik
# alamat web (pakai 0.0.0.0:8090 agar bisa diakses dari komputer lain di LAN)
LISTEN=127.0.0.1:8090
# BASE_PATH=/simrs
# rahasia untuk token CSRF (isi string acak panjang)
SESSION_SECRET=
# dipakai SEKALI untuk membuat user admin bila tabel user masih kosong
# ADMIN_PASSWORD=

# Bridging BPJS: off | mock (server tiruan lokal) | dev | prod
BPJS_MODE=off
BPJS_CONS_ID=
BPJS_SECRET=
BPJS_USER_KEY_VCLAIM=
BPJS_USER_KEY_ANTREAN=
BPJS_KODE_PPK=
BPJS_NAMA_PPK=
# opsional, menimpa URL bawaan dev/prod
# BPJS_VCLAIM_URL=
# BPJS_ANTREAN_URL=
